# Hermes API Server — the only runtime HTTP upstream used by Worker Studio.
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-a-long-random-secret
HERMES_WORKER_STUDIO_API_URL=http://127.0.0.1:8642

# Studio bridges are loopback-only unless remote access is explicitly opted in.
HERMES_WORKER_STUDIO_ALLOW_REMOTE=0

# Optional transport tuning.
HERMES_WORKER_STUDIO_HTTP_TIMEOUT=30
HERMES_WORKER_STUDIO_STREAM_TIMEOUT=7200
HERMES_WORKER_STUDIO_RUN_TTL=21600

# Worker/Verifier execution has no sidecar service. It is provided in-process by
# Hermes PluginContext.subagent_lifecycle and configured through Hermes
# delegation.*, auxiliary.review.*, approvals.*, and plugin settings.
