# Hermes API Server (official Hermes gateway surface)
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-a-long-random-secret
HERMES_WORKER_STUDIO_API_URL=http://127.0.0.1:8642

# codex-worker-delegation local control plane
HERMES_WORKER_STUDIO_WORKER_URL=http://127.0.0.1:8788
# Only needed when CWD_WEB_TOKEN is enabled on the Worker service.
# HERMES_WORKER_STUDIO_WORKER_TOKEN=replace-with-cwd-web-token

# Keep upstream bridge targets loopback-only by default.
HERMES_WORKER_STUDIO_ALLOW_REMOTE=0

# Worker service policy for the user's requested local unattended mode.
CWD_REQUIRE_AUTH=0
CWD_ALLOW_DANGER_FULL_ACCESS=1

# Studio native worker_delegate defaults to unattended full access.
HERMES_WORKER_STUDIO_DEFAULT_SANDBOX=danger-full-access
